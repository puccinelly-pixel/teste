# Copie este arquivo para .env e ajuste os valores.
# Gere uma chave forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave-por-uma-chave-aleatoria-e-longa

# Tempo de vida do token de acesso (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Banco de dados SQLite (arquivo criado automaticamente)
DATABASE_URL=sqlite:///./todo.db

# Origens autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Tentativas de login permitidas por IP dentro da janela abaixo
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
